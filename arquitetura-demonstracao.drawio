<mxfile host="app.diagrams.net" modified="2026-09-11T20:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="aws-vpc-rds-architecture" name="Arquitetura AWS VPC + RDS + Bastion">
    <mxGraphModel dx="1420" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titulo do Diagrama -->
        <mxCell id="title" value="Arquitetura AWS — VPC Segregada, RDS PostgreSQL Privado e Bastion Host (sa-east-1)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Demonstração do isolamento de banco de dados em rede privada com acesso administrativo via Jump Host (Etapas 1 a 4 concluídas)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#5A6B7C;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="850" height="20" as="geometry" />
        </mxCell>

        <!-- EXTERNO: Usuario / Administrador -->
        <mxCell id="user_box" value="Administrador&#xa;(PowerShell / Windows)&#xa;IP Residencial" style="shape=mxgraph.aws4.user;perimeter=boxPerimeter;html=1;whiteSpace=wrap;fontSize=12;verticalAlign=bottom;align=center;fillColor=#ED7100;strokeColor=none;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="90" height="90" as="geometry" />
        </mxCell>

        <!-- INTERNET GATEWAY -->
        <mxCell id="igw" value="Internet Gateway&#xa;(projeto-igw)" style="shape=mxgraph.aws4.internet_gateway;html=1;whiteSpace=wrap;fontSize=11;verticalAlign=bottom;align=center;fillColor=#8C4FFF;strokeColor=none;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="305" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- VPC CONTAINER -->
        <mxCell id="vpc_group" value="VPC: projeto-vpc (10.0.0.0/16) — Região sa-east-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=14;fontStyle=1;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="350" y="110" width="950" height="720" as="geometry" />
        </mxCell>

        <!-- AVAILABILITY ZONE 1 (sa-east-1a) -->
        <mxCell id="az_a" value="Availability Zone: sa-east-1a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0073BB;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontStyle=2;fontColor=#0073BB;" vertex="1" parent="vpc_group">
          <mxGeometry x="30" y="45" width="430" height="645" as="geometry" />
        </mxCell>

        <!-- SUBNET PUBLICA (sa-east-1a) -->
        <mxCell id="subnet_pub" value="Subnet Pública: projeto-subnet-publica (10.0.1.0/24)&#xa;Rota: 0.0.0.0/0 → projeto-igw | Auto-assign IP: Sim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#7AA116;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=11;fontStyle=1;fontColor=#248814;" vertex="1" parent="az_a">
          <mxGeometry x="20" y="45" width="390" height="270" as="geometry" />
        </mxCell>

        <!-- SECURITY GROUP EC2 -->
        <mxCell id="sg_ec2" value="Security Group: projeto-sg-ec2&#xa;Inbound: Porta 22 (SSH) autorizada só do IP do Administrador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;dashed=1;verticalAlign=top;align=center;spacingTop=5;fontSize=10;fontColor=#ED7100;fontStyle=1;" vertex="1" parent="subnet_pub">
          <mxGeometry x="25" y="55" width="340" height="195" as="geometry" />
        </mxCell>

        <!-- EC2 INSTANCE -->
        <mxCell id="ec2_bastion" value="EC2: projeto-bastion&#xa;(Amazon Linux 2023 · t2.micro)&#xa;IP Privado: 10.0.1.222&#xa;IP Público: 18.230.24.106&#xa;Key: projeto-keypair.pem" style="shape=mxgraph.aws4.ec2;verticalAlign=bottom;align=center;html=1;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#232F3E;spacingTop=5;" vertex="1" parent="sg_ec2">
          <mxGeometry x="90" y="45" width="160" height="120" as="geometry" />
        </mxCell>

        <!-- SUBNET PRIVADA 2 (sa-east-1a) -->
        <mxCell id="subnet_priv_2" value="Subnet Privada 2: projeto-subnet-privada-2 (10.0.3.0/24)&#xa;Rota: local apenas (Sem acesso à internet) | DB Subnet Group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#00A4A6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=11;fontStyle=1;fontColor=#00A4A6;" vertex="1" parent="az_a">
          <mxGeometry x="20" y="340" width="390" height="275" as="geometry" />
        </mxCell>
        <mxCell id="subnet_priv_2_desc" value="Criada para cumprir a exigência do RDS de abranger ≥ 2 AZs.&#xa;Garante alta disponibilidade para o DB Subnet Group." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#5A6B7C;" vertex="1" parent="subnet_priv_2">
          <mxGeometry x="30" y="100" width="330" height="60" as="geometry" />
        </mxCell>

        <!-- AVAILABILITY ZONE 2 (sa-east-1b) -->
        <mxCell id="az_b" value="Availability Zone: sa-east-1b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0073BB;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=13;fontStyle=2;fontColor=#0073BB;" vertex="1" parent="vpc_group">
          <mxGeometry x="490" y="45" width="430" height="645" as="geometry" />
        </mxCell>

        <!-- SUBNET PRIVADA 1 (sa-east-1b) -->
        <mxCell id="subnet_priv_1" value="Subnet Privada: projeto-subnet-privada (10.0.2.0/24)&#xa;Rota: local apenas (Sem acesso à internet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#00A4A6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=11;fontStyle=1;fontColor=#00A4A6;" vertex="1" parent="az_b">
          <mxGeometry x="20" y="45" width="390" height="570" as="geometry" />
        </mxCell>

        <!-- SECURITY GROUP RDS -->
        <mxCell id="sg_rds" value="Security Group: projeto-sg-rds&#xa;Inbound: Porta 5432 (PostgreSQL) liberada para a VPC (10.0.0.0/16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E73B8;strokeWidth=1.5;dashed=1;verticalAlign=top;align=center;spacingTop=5;fontSize=10;fontColor=#2E73B8;fontStyle=1;" vertex="1" parent="subnet_priv_1">
          <mxGeometry x="25" y="120" width="340" height="340" as="geometry" />
        </mxCell>

        <!-- RDS POSTGRESQL -->
        <mxCell id="rds_db" value="RDS PostgreSQL: projeto-db&#xa;(Engine: Postgres 15/16 · db.t4g/t3.micro)&#xa;Acesso Público: NÃO&#xa;Endpoint: projeto-db.cti6i6k0kvn7...&#xa;IP Privado interno: 10.0.0.218&#xa;Banco: postgres / projetodb" style="shape=mxgraph.aws4.rds_instance;verticalAlign=bottom;align=center;html=1;fontSize=11;fontStyle=1;fillColor=#2E73B8;strokeColor=none;fontColor=#232F3E;spacingTop=5;" vertex="1" parent="sg_rds">
          <mxGeometry x="85" y="70" width="170" height="180" as="geometry" />
        </mxCell>

        <!-- DB SUBNET GROUP BADGE -->
        <mxCell id="db_subnet_badge" value="DB Subnet Group: projeto-db-subnet-group&#xa;(Cobre as Subnets Privadas em sa-east-1a e sa-east-1b)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#2E73B8;strokeWidth=1;fontSize=11;fontStyle=1;fontColor=#2E73B8;align=center;" vertex="1" parent="vpc_group">
          <mxGeometry x="260" y="20" width="420" height="30" as="geometry" />
        </mxCell>

        <!-- FLUXO 1: SSH do Admin ate o Bastion -->
        <mxCell id="flow_ssh_1" value="1. SSH (Porta 22)&#xa;projeto-keypair.pem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#ED7100;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user_box" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flow_ssh_2" value="2. Roteamento via IGW&#xa;para IP Público 18.230.24.106" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#ED7100;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="igw" target="ec2_bastion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FLUXO 2: Bastion ate RDS via rede interna -->
        <mxCell id="flow_rds" value="3. psql -h ... -U postgres (Porta 5432)&#xa;Tráfego 100% interno privado na VPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;sourceX=1;sourceY=0.5;entryX=0;entryY=0.5;strokeColor=#00A4A6;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#00A4A6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ec2_bastion" target="rds_db">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="470" />
              <mxPoint x="830" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- BLOQUEIO DIRETO DA INTERNET AO RDS (Seguranca) -->
        <mxCell id="block_cross" value="BLOQUEIO TOTAL&#xa;Sem rota de Internet e sem IP Público&#xa;RDS inacessível de fora da VPC" style="shape=mxgraph.signs.protection.lock;html=1;pointerEvents=1;fillColor=#D13212;strokeColor=none;verticalAlign=bottom;align=center;fontSize=11;fontStyle=1;fontColor=#D13212;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1170" y="470" width="70" height="80" as="geometry" />
        </mxCell>

        <!-- LEGENDA TECNICA -->
        <mxCell id="legend_box" value="Legenda do Padrão de Arquitetura Bastion Host (Three-Tier Security):&#xa;• Subnet Pública: Contém recursos que precisam conversar com o mundo externo (EC2 Bastion com Elastic/Public IP).&#xa;• Subnet Privada: Contém dados críticos (RDS). Não possui Internet Gateway nem IP público.&#xa;• Segurança em Camadas: O usuário autentica no Bastion com chave RSA (.pem) e salta para o banco via rede interna (10.0.0.0/16)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;fontSize=11;fontColor=#4A5568;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="290" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
